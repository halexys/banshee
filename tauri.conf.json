{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Banshee",
  "version": "0.1.0",
  "identifier": "dev.halexys.banshee",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Banshee",
        "width": 1180,
        "height": 800,
        "minWidth": 760,
        "minHeight": 560,
        "visible": false,
        "backgroundColor": "#0B0E11"
      },
      {
        "label": "panel",
        "url": "panel.html",
        "title": "Banshee Panel",
        "width": 380,
        "height": 560,
        "resizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "backgroundColor": "#0F1317"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
